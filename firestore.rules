rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin(){ return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /leads/{id} { allow create: if true; allow read,update,delete: if isAdmin(); }
    match /{collectionName}/{docId} { allow read: if collectionName in ['heroSlides','services','categories','gallery','why','projects','testimonials','blogs','faqs','pricing','siteSettings']; allow create,update,delete: if isAdmin(); }
  }
}
